&glm_setup
   sim_name = 'Notthatdeep'
   max_layers = 250
   min_layer_vol = 0.025
   min_layer_thick = 0.15
   max_layer_thick = 1.5
   density_model = 1
/
&mixing
   surface_mixing = 1
   coef_mix_conv = 0.2
   coef_wind_stir = 0.23
   coef_mix_shear = 0.3
   coef_mix_turb = 0.51
   coef_mix_KH = 0.3
   deep_mixing = 2
   coef_mix_hyp = 0.5
   diff = 0
/
&wq_setup
   wq_lib = 'aed2'
   wq_nml_file = 'aed2.nml'
   ode_method = 1
   split_factor = 1
   bioshade_feedback = .true.
   repair_state = .true.
/
&morphometry
   lake_name = 'Batur'
   latitude = -8.25
   longitude = 115.2
   base_elev = -70
   crest_elev = 0
   bsn_len = 6820
   bsn_wid = 2600
   bsn_vals = 8
   H = -70, -60, -50, -40, -30, -20, -10, 0
   A = 97734.74801, 996894.4297, 6670396.552, 9560901.725, 11439852.26, 12957184.22, 14391441.65, 16065149.2
/
&time
   timefmt = 2
   start = '2022-10-15'
   stop = '2023-10-12'
   dt = 3600
   num_days = 360
   timezone = 7
/
&output
   out_dir = 'output'
   out_fn = 'output'
   nsave = 12
   csv_lake_fname = 'lake'
   csv_point_nlevs = 2
   csv_point_fname = 'WQ_'
   csv_point_at = 0, 5
   csv_point_nvars = 8
   csv_point_vars = 'temp','PHS_frp','OXY_oxy','PHY_TCHLA','NIT_amm','NIT_nit','TOT_tn','TOT_tp'
/
&init_profiles
   lake_depth = 70
   num_depths = 7
   the_depths = 0, 5, 10, 20, 40, 60, 70
   the_temps = 24.95, 24.07, 23.95, 23.42, 23.29, 23.28, 23.28
   the_sals = 0, 0, 0, 0, 0, 0, 0
   num_wq_vars = 8
   wq_names = 'OXY_oxy',
			  'TOT_tp',
			  'TOT_tn',
			  'PHS_frp',
			  'NIT_amm',
			  'NIT_nit',
			  'PHY_diatom',
			  'PHY_cyano'
   wq_init_vals = 180, 175, 171.88, 52.5, 1.68, 1.6, 0,
					1, 1, 1.5, 2, 5, 10, 10,
					40, 10, 10, 20, 50, 60, 70, 
					0.6, 0.6, 0.6, 0.6, 3, 3, 3, 
					2.7, 2.7, 5.54, 16, 38.8, 38.8, 49.893, 
					16, 16, 16, 1.6, 1.6, 0.315, 0.421, 
					5, 5, 1, 1, 1, 1, 1, 
					1, 6, 4, 1, 1, 1, 1
/
&meteorology
   met_sw = .true.
   lw_type = 'LW_CC'
   rain_sw = .true.
   atm_stab = .false.
   fetch_mode = 0
   rad_mode = 1
   albedo_mode = 1
   cloud_mode = 4
   subdaily = .true.
   meteo_fl = 'bcs/to_glm.csv'
   wind_factor = 1.95
   sw_factor = 1.02
   lw_factor = 1.01
   rh_factor = 1
   rain_factor = 0.2
   ce = 0.0013
   ch = 0.0013
   cd = 0.0013
   catchrain = .false.
   rain_threshold = 0.01
   runoff_coef = 0.2
/
&light
   light_mode = 0
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 0.86
/
&bird_model
   AP = 973
   Oz = 0.279
   WatVap = 1.1
   AOD500 = 0.033
   AOD380 = 0.038
   Albedo = 1
/
&inflow
   num_inflows = 1
   names_of_strms = 'kja'
   subm_flag = .false.
   strm_hf_angle = 160
   strmbd_slope = 8
   strmbd_drag = 0.016
   inflow_factor = 1
   inflow_fl = 'bcs/inflow.csv'
   inflow_varnum = 8
   inflow_vars = 'flow','temp','salt','OXY_oxy','OGM_dop','OGM_pop','OGM_don','OGM_pon'
   coef_inf_entrain = 0
/
&outflow
   num_outlet = 1
   flt_off_sw = .false.
   outl_elvs = -70
   bsn_len_outl = 1
   bsn_wid_outl = 1
   outflow_fl = 'bcs/outflow.csv'
   outflow_factor = 1
   seepage = .false.
   seepage_rate = 1.2e-06
/
&sediment
   sed_heat_Ksoil = 2
   sed_temp_depth = 0.2
   sed_temp_mean = 22, 22, 22
   sed_temp_amplitude = 1, 1, 1
   sed_temp_peak_doy = 242, 242, 242
   benthic_mode = 2
   n_zones = 3
   zone_heights = 10, 20, 30
   sed_reflectivity = 0.1, 0.01, 0.01
   sed_roughness = 0.1, 0.01, 0.01
/
